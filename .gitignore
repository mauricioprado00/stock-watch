# The data (store/, the *.js files the page reads, stocks.json) is committed on purpose:
# the published copy of the page shows the last committed snapshot.

# Holds the random code that lets pages edit alarms: never commit it
api.js

# Only meaningful while the tracker runs
tracker.log
tracker.pid

# Files from before the stock command existed
old/

__pycache__/
*.tmp
_test.html
